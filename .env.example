# Quorum — API keys (copy to .env, never commit .env)
#
# Quorum's pipeline runs fully offline. A Gemini key unlocks the two optional
# LLM-backed features (both opt-in, graceful fallback if absent):
#   • the real Cognee knowledge graph (add → cognify → search)
#   • the Gemini-polished SAR memo (QUORUM_LLM_POLISH=1)

# ── Google Gemini (LLM + embeddings for Cognee) ──
GEMINI_API_KEY=your_gemini_key_here
LLM_PROVIDER=gemini

# Cognee LLM + embedding config (sensible defaults are set in code; override here)
# LLM_MODEL=gemini/gemini-2.5-flash
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIMENSIONS=3072

# Toggle the optional Gemini memo polish (template memo is the default output)
# QUORUM_LLM_POLISH=1

# Force the Cognee layer on/off (auto = on when GEMINI_API_KEY is present)
# QUORUM_COGNEE=auto   # auto | on | off

# ── Alternatives (not used by the Cognee layer; Gemini is the default) ──
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here
