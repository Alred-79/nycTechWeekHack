{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {"type":"text","id":"title","x":150,"y":0,"width":520,"height":30,"text":"How PyMC is used  —  Agent 2 (Estimator)","fontSize":24,"strokeColor":"#1e1e1e","textAlign":"left","verticalAlign":"top"},
    {"type":"text","id":"sub","x":195,"y":36,"width":440,"height":20,"text":"agents/ranker.py - masked two-component Bayesian mixture, NUTS","fontSize":15,"strokeColor":"#757575","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"data","x":40,"y":80,"width":270,"height":110,"roundness":{"type":3},"backgroundColor":"#c3fae8","fillStyle":"solid","strokeColor":"#06b6d4","strokeWidth":2,"boundElements":[{"type":"text","id":"dataT"}]},
    {"type":"text","id":"dataT","x":50,"y":98,"width":250,"height":74,"text":"INPUTS from Cognee\n(written by the Detector)\nX = signals that fired\nM = applicability mask","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"data"},
    {"type":"rectangle","id":"priors","x":350,"y":80,"width":400,"height":110,"roundness":{"type":3},"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f59e0b","strokeWidth":2,"boundElements":[{"type":"text","id":"priorsT"}]},
    {"type":"text","id":"priorsT","x":360,"y":90,"width":380,"height":90,"text":"PRIORS\npi ~ Beta(1,9)  (mules are rare)\nphi_mule ~ Beta(4,1)\nphi_legit ~ Beta(1,4)\nfire-rates are LEARNED by the sampler","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"priors"},
    {"type":"text","id":"keytag","x":300,"y":196,"width":120,"height":20,"text":"THE KEY LINE","fontSize":15,"strokeColor":"#8b5cf6","textAlign":"left","verticalAlign":"top"},
    {"type":"arrow","id":"a1","x":175,"y":191,"width":120,"height":24,"points":[[0,0],[120,24]],"strokeColor":"#06b6d4","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"arrow","id":"a2","x":550,"y":191,"width":90,"height":24,"points":[[0,0],[-90,24]],"strokeColor":"#f59e0b","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"like","x":120,"y":215,"width":520,"height":95,"roundness":{"type":3},"backgroundColor":"#d0bfff","fillStyle":"solid","strokeColor":"#8b5cf6","strokeWidth":3,"boundElements":[{"type":"text","id":"likeT"}]},
    {"type":"text","id":"likeT","x":130,"y":238,"width":500,"height":48,"text":"MASKED LIKELIHOOD  (per account, per class k)\nll_k = sum( M * [ X*log(phi_k) + (1-X)*log(1-phi_k) ] )","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"like"},
    {"type":"arrow","id":"n1","x":640,"y":262,"width":15,"height":0,"points":[[0,0],[15,0]],"strokeColor":"#f59e0b","strokeWidth":1,"strokeStyle":"dashed","endArrowhead":"arrow"},
    {"type":"rectangle","id":"note1","x":655,"y":212,"width":150,"height":112,"roundness":{"type":3},"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f59e0b","strokeWidth":1,"boundElements":[{"type":"text","id":"note1T"}]},
    {"type":"text","id":"note1T","x":663,"y":220,"width":134,"height":96,"text":"KEY: M zeroes signals that CANNOT fire -> treated as missing, not as innocence (sinks stay confident, AC-0012 stays uncertain)","fontSize":13,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"note1"},
    {"type":"arrow","id":"a3","x":380,"y":310,"width":0,"height":45,"points":[[0,0],[0,45]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"mix","x":120,"y":355,"width":520,"height":90,"roundness":{"type":3},"backgroundColor":"#ffd8a8","fillStyle":"solid","strokeColor":"#f59e0b","strokeWidth":2,"boundElements":[{"type":"text","id":"mixT"}]},
    {"type":"text","id":"mixT","x":130,"y":368,"width":500,"height":64,"text":"MIXTURE  via  pm.Potential\nlog_mix = [ log(pi)+ll_mule ,  log(1-pi)+ll_legit ]\nPotential = sum( logsumexp(log_mix) )","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"mix"},
    {"type":"arrow","id":"n2","x":640,"y":400,"width":15,"height":0,"points":[[0,0],[15,0]],"strokeColor":"#f59e0b","strokeWidth":1,"strokeStyle":"dashed","endArrowhead":"arrow"},
    {"type":"rectangle","id":"note2","x":655,"y":356,"width":150,"height":92,"roundness":{"type":3},"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f59e0b","strokeWidth":1,"boundElements":[{"type":"text","id":"note2T"}]},
    {"type":"text","id":"note2T","x":663,"y":364,"width":134,"height":76,"text":"logsumexp marginalizes the hidden class out -> smooth gradient, so NUTS can sample it","fontSize":13,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"note2"},
    {"type":"arrow","id":"a4","x":380,"y":445,"width":0,"height":45,"points":[[0,0],[0,45]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"nuts","x":260,"y":490,"width":240,"height":66,"roundness":{"type":3},"backgroundColor":"#a5d8ff","fillStyle":"solid","strokeColor":"#4a9eed","strokeWidth":2,"boundElements":[{"type":"text","id":"nutsT"}]},
    {"type":"text","id":"nutsT","x":270,"y":513,"width":220,"height":20,"text":"pm.sample( NUTS / nutpie, 4 chains )","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"nuts"},
    {"type":"arrow","id":"a5","x":380,"y":556,"width":0,"height":39,"points":[[0,0],[0,39]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"theta","x":170,"y":595,"width":420,"height":80,"roundness":{"type":3},"backgroundColor":"#eebefa","fillStyle":"solid","strokeColor":"#ec4899","strokeWidth":2,"boundElements":[{"type":"text","id":"thetaT"}]},
    {"type":"text","id":"thetaT","x":180,"y":613,"width":400,"height":44,"text":"theta = P(mule | signals)  per account\nFULL posterior, not a point estimate","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"theta"},
    {"type":"arrow","id":"a6","x":330,"y":675,"width":93,"height":45,"points":[[0,0],[-93,45]],"strokeColor":"#ec4899","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"arrow","id":"a7","x":430,"y":675,"width":92,"height":45,"points":[[0,0],[92,45]],"strokeColor":"#ec4899","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"pmule","x":110,"y":720,"width":255,"height":70,"roundness":{"type":3},"backgroundColor":"#b2f2bb","fillStyle":"solid","strokeColor":"#22c55e","strokeWidth":2,"boundElements":[{"type":"text","id":"pmuleT"}]},
    {"type":"text","id":"pmuleT","x":120,"y":735,"width":235,"height":40,"text":"p_mule\n= posterior mean","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"pmule"},
    {"type":"rectangle","id":"ci","x":395,"y":720,"width":255,"height":70,"roundness":{"type":3},"backgroundColor":"#b2f2bb","fillStyle":"solid","strokeColor":"#22c55e","strokeWidth":2,"boundElements":[{"type":"text","id":"ciT"}]},
    {"type":"text","id":"ciT","x":405,"y":735,"width":235,"height":40,"text":"94% credible interval\n(_hdi94)","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"ci"},
    {"type":"arrow","id":"a8","x":237,"y":790,"width":0,"height":40,"points":[[0,0],[0,40]],"strokeColor":"#22c55e","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"arrow","id":"a9","x":522,"y":790,"width":0,"height":40,"points":[[0,0],[0,40]],"strokeColor":"#22c55e","strokeWidth":2,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"out","x":120,"y":830,"width":530,"height":50,"roundness":{"type":3},"backgroundColor":"#c3fae8","fillStyle":"solid","strokeColor":"#06b6d4","strokeWidth":2,"boundElements":[{"type":"text","id":"outT"}]},
    {"type":"text","id":"outT","x":130,"y":845,"width":510,"height":20,"text":"accreted onto the Case node in Cognee  ->  Agent 3 (Adjudicator)","fontSize":15,"strokeColor":"#1e1e1e","textAlign":"center","verticalAlign":"middle","containerId":"out"}
  ],
